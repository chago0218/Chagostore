<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CHAGO STORE</title>

<link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@400;600;700&display=swap" rel="stylesheet">

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Pretendard,sans-serif;}
body{background:#f5f5f5;}
header{
position:sticky;
top:0;
background:#fff;
padding:15px;
display:flex;
justify-content:space-between;
align-items:center;
box-shadow:0 2px 10px rgba(0,0,0,.08);
z-index:100;
}
.logo{
font-size:28px;
font-weight:700;
}
.search{
width:100%;
margin:20px auto;
max-width:700px;
padding:0 20px;
}
.search input{
width:100%;
padding:15px;
border-radius:12px;
border:1px solid #ddd;
font-size:16px;
}

.banner{
margin:20px;
height:220px;
border-radius:20px;
background:linear-gradient(135deg,#000,#444);
color:#fff;
display:flex;
flex-direction:column;
justify-content:center;
padding:30px;
}

.banner h1{
font-size:34px;
}

.banner p{
margin-top:10px;
opacity:.8;
}

.category{
display:flex;
overflow:auto;
gap:10px;
padding:15px;
}

.category button{
padding:12px 20px;
border:none;
border-radius:30px;
background:white;
font-weight:bold;
}

.products{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:15px;
padding:15px;
}

.card{
background:white;
border-radius:18px;
overflow:hidden;
box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.card img{
width:100%;
height:220px;
object-fit:cover;
}

.info{
padding:15px;
}

.price{
font-size:20px;
font-weight:bold;
margin:10px 0;
}

.buy{
width:100%;
padding:13px;
background:black;
color:white;
border:none;
border-radius:12px;
cursor:pointer;
}
</style>

</head>

<body>

<header>
<div class="logo">CHAGO</div>
❤️
</header>

<div class="search">
<input placeholder="상품 검색">
</div>

<div class="banner">
<h1>NEW COLLECTION</h1>
<p>CHAGO 2026 SUMMER</p>
</div>

<div class="category">
<button>전체</button>
<button>상의</button>
<button>하의</button>
<button>신발</button>
<button>악세사리</button>
</div>

<div class="products">

<div class="card">

<img src="https://picsum.photos/500/500">

<div class="info">

<h3>오프화이트 반팔</h3>

<div class="price">₩39,000</div>

★★★★★

<br><br>

<button class="buy">
스마트스토어에서 구매
</button>

</div>

</div>

<div class="card">

<img src="https://picsum.photos/501/501">

<div class="info">

<h3>와이드 데님</h3>

<div class="price">₩59,000</div>

★★★★★

<br><br>

<button class="buy">
스마트스토어에서 구매
</button>

</div>

</div>

</div>

</body>

</html>
